    "import matplotlib.pyplot as plt\n",
    "\n",
    "advertising = [10, 20, 30, 40, 50]\n",
    "sales = [100, 150, 200, 250, 300]\n",
    "\n",
    "plt.scatter(advertising, sales)\n",
    "plt.title(\"Advertising Spend vs Sales\")\n",
    "plt.xlabel(\"Advertising Spend\")\n",
    "plt.ylabel(\"Sales\")\n",
    "plt.show()"
   ]
  }
