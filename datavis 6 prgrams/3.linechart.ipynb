   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "months = ['Jan', 'Feb', 'Mar', 'Apr', 'May']\n",
    "revenue = [2000, 2500, 2200, 3000, 3500]\n",
    "\n",
    "plt.plot(months, revenue, marker='o')\n",
    "plt.title(\"Monthly Revenue\")\n",
    "plt.xlabel(\"Months\")\n",
    "plt.ylabel(\"Revenue\")\n",
    "plt.show()"
   ]
  }
